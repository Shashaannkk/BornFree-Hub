# Public client configuration (safe for browser exposure via runtime config / build injection)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
PUBLIC_APP_ENV=development

# Server-only secrets (NEVER expose in frontend JS/HTML; configure ONLY in Supabase Edge Function secrets)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# STAFF_INVITE_WEBHOOK_SECRET=your-webhook-secret
