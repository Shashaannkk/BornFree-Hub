# ==============================================================================
# BONFREE-HUB Environment Variables Template
# ==============================================================================

# 1. Public Frontend Config (Safe for browser; injected by scripts/build-vercel.mjs)
# Set these in Vercel -> Project Settings -> Environment Variables:
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Set to "production" on Vercel Production deployments ("development" locally)
PUBLIC_APP_ENV=development

# 2. Server-Only Secrets (NEVER place in frontend HTML/JS or Vercel public bundles)
# Set these exclusively in Supabase Edge Function secrets (`supabase secrets set`):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# APP_ENV=production
# Comma-separated list of exact allowed browser origins (no trailing slashes):
# ALLOWED_ORIGIN=https://bonfree-hub.com,https://www.bonfree-hub.com,https://bonfree-hub.vercel.app
